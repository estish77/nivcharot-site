# DB adapter is picked automatically by payload.config.ts based on this
# value — a `file:` URL selects SQLite (zero external infrastructure,
# right for local dev), anything else selects Postgres (right for
# production, since SQLite's local file doesn't survive most hosts'
# ephemeral filesystem, e.g. Vercel serverless). Nothing to change in code
# either way — just set the right value per environment.
#
# Local dev (default if unset):
DATABASE_URI=file:./payload.db
#
# Production, e.g. a free-tier Neon or Supabase Postgres instance. Neon
# gives you TWO connection strings for the same database — the hostname
# is the only difference (pooled has "-pooler" in it, direct doesn't):
#   # DATABASE_URI: the POOLED one (has "-pooler" in the hostname) — the
#   # running app should always use this, it's built for many short-lived
#   # concurrent connections (exactly what serverless functions open):
#   DATABASE_URI=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
#   # DATABASE_URI_DIRECT: the one WITHOUT "-pooler" — only used by
#   # `payload migrate`, which needs a direct (non-pooled) connection:
#   DATABASE_URI_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# IMPORTANT: never run `next dev` (or anything else in dev mode) against a
# production DATABASE_URI. Dev mode auto-pushes schema changes and writes
# a `batch: -1` marker into the `payload_migrations` table recording that
# it did — production startup sees that marker and blocks on an
# interactive "data loss will occur, proceed? (y/N)" confirmation prompt,
# which a real server can never answer, hanging every request. If this
# ever happens, delete the `name = 'dev', batch = -1` row from
# `payload_migrations` directly (it's just a tracking marker, not content).

# Long random string Payload uses for encryption/signing. Generate one with:
# `openssl rand -base64 32`
PAYLOAD_SECRET=

# Vercel Blob storage read/write token. Same auto-switch as DATABASE_URI
# above: unset locally (uploads go to the local `media/` folder, see
# Media.ts), set in production so uploads persist in Vercel Blob instead of
# a local disk that doesn't survive a deploy. Get one from the Vercel
# dashboard once a Blob store is created for the project.
BLOB_READ_WRITE_TOKEN=

# Shared secret required to authorize Payload's scheduled cron/job endpoints.
CRON_SECRET=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Same
# auto-switch as BLOB_READ_WRITE_TOKEN above: unset locally so dev traffic
# never gets counted, set only in Vercel's Production environment (not
# Preview) so preview-deployment traffic doesn't get counted either.
# Find it in GA4 under Admin -> Data Streams -> (your web stream).
NEXT_PUBLIC_GA_ID=
