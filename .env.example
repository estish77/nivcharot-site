# DB adapter is picked automatically by payload.config.ts based on this
# value — a `file:` URL selects SQLite (zero external infrastructure,
# right for local dev), anything else selects Postgres (right for
# production, since SQLite's local file doesn't survive most hosts'
# ephemeral filesystem, e.g. Vercel serverless). Nothing to change in code
# either way — just set the right value per environment.
#
# Local dev (default if unset):
DATABASE_URI=file:./payload.db
#
# Production, e.g. a free-tier Neon or Supabase Postgres instance:
#   DATABASE_URI=postgresql://user:password@host:5432/nivcharot
#   # Direct (non-pooled) connection, required by `payload migrate` against
#   # providers that pool DATABASE_URI (e.g. Neon, Supabase):
#   DATABASE_URI_DIRECT=postgresql://user:password@host:5432/nivcharot

# Long random string Payload uses for encryption/signing. Generate one with:
# `openssl rand -base64 32`
PAYLOAD_SECRET=

# Vercel Blob storage read/write token. Same auto-switch as DATABASE_URI
# above: unset locally (uploads go to the local `media/` folder, see
# Media.ts), set in production so uploads persist in Vercel Blob instead of
# a local disk that doesn't survive a deploy. Get one from the Vercel
# dashboard once a Blob store is created for the project.
BLOB_READ_WRITE_TOKEN=

# Shared secret required to authorize Payload's scheduled cron/job endpoints.
CRON_SECRET=
