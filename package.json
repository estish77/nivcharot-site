{
  "name": "nivcharot-site",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Bilingual (Hebrew RTL / English LTR) site for Nivcharot",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:types && next build",
    "start": "next start",
    "lint": "eslint .",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "create-admin": "payload run scripts/create-admin-user.mjs",
    "export-content": "payload run scripts/export-content.mjs",
    "import-content": "payload run scripts/import-content.mjs",
    "seed-home": "payload run scripts/seed-home-global.mjs",
    "seed-remaining": "payload run scripts/seed-remaining-globals.mjs",
    "seed-faqs": "payload run scripts/seed-faqs.mjs",
    "seed-alumnae-quotes": "payload run scripts/seed-alumnae-quotes.mjs",
    "seed-timeline": "payload run scripts/seed-timeline-milestones.mjs",
    "seed-press-archive": "payload run scripts/seed-press-archive.mjs",
    "seed-elsewhere-media": "payload run scripts/seed-elsewhere-media.mjs",
    "seed-legacy-posts": "payload run scripts/seed-legacy-posts.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.0",
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/db-sqlite": "^3.87.1",
    "@payloadcms/email-nodemailer": "^3.87.1",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/storage-vercel-blob": "^3.87.1",
    "@payloadcms/ui": "^3.87.0",
    "graphql": "^16.8.1",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "payload": "^3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
